# Copy this file to backend/.env only when running the backend from backend/
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<existing-cluster>/<existing-database>?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_DURATION=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-one-time-bootstrap-token
ADMIN_INVITATION_CODE=replace-with-your-project-admin-invitation-code
