# Backend
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_DURATION=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# For the HTTPS Manus-hosted Preview, use COOKIE_SECURE=true and COOKIE_SAMESITE=none
# so the HTTP-only session cookie can work inside the embedded Preview iframe.
# Set this only when intentionally creating an administrator through the protected bootstrap endpoint.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-one-time-bootstrap-token
# Project-level code required by the public Admin registration page.
ADMIN_INVITATION_CODE=replace-with-your-project-admin-invitation-code

# Frontend (Vite)
VITE_API_BASE_URL=/api
